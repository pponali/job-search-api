# =====================================================================
# Job Search API — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# =====================================================================

# --- Notion (REQUIRED for /notion/* endpoints + discover-once.mjs) ---
# Create an internal integration: https://www.notion.so/my-integrations
# Then share your Jobs database with the integration.
NOTION_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Server ---
API_PORT=9500

# --- Career-ops integration (OPTIONAL: enables /evaluate, /generate-pdf, /tailor-resume) ---
# Path to a local clone of your career-ops repo containing cv.md, modes/, reports/, output/.
CAREER_OPS_DIR=

# --- AIHawk integration (OPTIONAL: enables /generate-resume, /apply, /apply-semi) ---
# Path to local Jobs_Applier_AI_Agent_AIHawk clone.
AIHAWK_DIR=
RESUME_YAML=

# --- LinkedIn auto-apply credentials (OPTIONAL: only for /apply) ---
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- LinkedIn OAuth (OPTIONAL: only if you use linkedin_oauth.py) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_HOST=localhost
LINKEDIN_REDIRECT_PORT=8585

# --- Naukri auto-apply credentials (OPTIONAL) ---
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# --- Tailored resume publishing (OPTIONAL: only for /tailor-resume) ---
# Local path to a git repo where generated PDFs are committed + pushed.
RESUMES_REPO=
# Public raw URL base where pushed resume files become accessible.
RESUMES_RAW_BASE=

# --- Resume worker (OPTIONAL) ---
POLL_INTERVAL_MS=30000

# --- JobSpy MCP server (used by start-all.sh) ---
# Path to local jobspy-mcp-server clone. See https://github.com/borgius/jobspy-mcp-server
JOBSPY_DIR=
JOBSPY_PORT=9423
